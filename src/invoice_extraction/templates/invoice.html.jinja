<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
  body { font-family: "DejaVu Sans", sans-serif; font-size: 12px; color: #222; margin: 40px; }
  h1 { font-size: 22px; margin: 0 0 20px 0; letter-spacing: 2px; }
  .header { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .vendor { font-weight: bold; font-size: 15px; max-width: 55%; }
  .vendor .addr { font-weight: normal; }
  .ids { font-size: 11px; color: #444; margin-top: 6px; }
  .meta { text-align: right; }
  .meta .client-label { font-weight: bold; margin-top: 10px; }
  table.items { width: 100%; border-collapse: collapse; margin-top: 24px; }
  table.items th, table.items td { border: 1px solid #999; padding: 6px 8px; text-align: left; }
  table.items th { background: #eee; }
  table.items td.num, table.items th.num { text-align: right; }
  table.totals { width: 280px; margin-left: auto; margin-top: 16px; border-collapse: collapse; }
  table.totals td { padding: 4px 8px; }
  table.totals td.label { text-align: left; }
  table.totals td.value { text-align: right; }
  table.totals tr.grand-total td { font-weight: bold; font-size: 14px; border-top: 2px solid #222; }
</style>
</head>
<body>
  <h1>FACTURE</h1>
  <div class="header">
    <div class="vendor">
      {{ vendor_name }}
      <div class="addr">{{ vendor_address }}</div>
      <div class="ids">ICE: {{ ice }} &nbsp;&nbsp; IF: {{ if_number }}</div>
    </div>
    <div class="meta">
      Facture N&deg; {{ invoice_number }}<br>
      Date: {{ invoice_date }}
      <div class="client-label">Client:</div>
      {{ client_name }}<br>
      {{ client_address }}
    </div>
  </div>

  <table class="items">
    <thead>
      <tr><th>D&eacute;signation</th><th class="num">Qt&eacute;</th><th class="num">P.U. ({{ currency }})</th><th class="num">Montant ({{ currency }})</th></tr>
    </thead>
    <tbody>
      {# The P.U. column is a deliberate distractor: real invoices always show
         a unit price next to the line total, and a model that grabs the wrong
         column is the most common real-world extraction failure. Ground truth
         is the Montant column. #}
      {% for item in items %}
      <tr><td>{{ item.name }}</td><td class="num">{{ item.qty }}</td><td class="num">{{ unit_prices[loop.index0] }}</td><td class="num">{{ item.price }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <table class="totals">
    <tr><td class="label">Total HT</td><td class="value">{{ subtotal }} {{ currency }}</td></tr>
    <tr><td class="label">TVA ({{ tax_rate_pct }}%)</td><td class="value">{{ tax }} {{ currency }}</td></tr>
    <tr class="grand-total"><td class="label">Total TTC</td><td class="value">{{ total }} {{ currency }}</td></tr>
  </table>
</body>
</html>
